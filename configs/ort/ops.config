# ONNX Runtime reduced operator build configuration
#
# Only the operators used by the ArcaeaOffline OCR model
# (client-android app/src/main/assets/ocr/model_patched.onnx, opset 17)
# are kept in the build, which drastically reduces libonnxruntime.so size.
#
# IMPORTANT: this list must cover the operators AFTER ORT graph optimization
# (session-level ORT_ENABLE_ALL), not just the raw model graph. E.g. the model
# only has MatMul+Add, but ORT's MatMulAddFusion optimizer folds them into Gemm
# (and FusedMatMul) nodes at session creation, so Gemm must be kept or session
# creation fails with ORT_NOT_IMPLEMENTED. Contrib-domain nodes (com.microsoft
# FusedMatMul, com.microsoft.nchwc ReorderOutput) are NOT filtered by this
# config and are always compiled in.
#
# Sample python script to get the optimized model (with ORT 1.26):
#   import onnxruntime as ort
#   import onnx
#   so = ort.SessionOptions()
#   so.optimized_model_filepath = "optimized.onnx"
#   ort.InferenceSession("model.onnx", so, providers=["CPUExecutionProvider"])
#   print(sorted({n.op_type for n in onnx.load("optimized.onnx").graph.node}))
#
# Format: <domain>;<opset>;<op1,op2,...>
ai.onnx;17;ArgMax,Cast,Concat,Conv,Gemm,GRU,MatMul,MaxPool,Mul,Relu,Reshape,Softmax,Tanh,Transpose,Unsqueeze
