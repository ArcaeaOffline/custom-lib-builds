# ONNX Runtime reduced operator build configuration
#
# Only the operators used by the ArcaeaOffline OCR model
# (client-android app/src/main/assets/ocr/model_patched.onnx, opset 17)
# are kept in the build, which drastically reduces libonnxruntime.so size.
#
# IMPORTANT: the list must be the UNION of
#   1. the raw model graph operators, AND
#   2. the operators introduced by ORT graph optimization (e.g. Gemm from MatMulAddFusion).
# Reason: ORT's ConstantFolding executes folding via the registered kernels, so
# a raw-graph op (e.g. Expand feeding GRU's sequence_lens) must have its kernel
# present even if the optimized graph no longer contains it — otherwise folding
# is skipped and session creation fails with ORT_NOT_IMPLEMENTED.
# Contrib-domain nodes (com.microsoft FusedMatMul, com.microsoft.nchwc
# ReorderOutput) are NOT filtered by this config and are always compiled in.
#
# Inspect the raw model ops:
#   python -c "import onnx; m=onnx.load('model.onnx'); print(sorted({n.op_type for n in m.graph.node}))"
#
# Inspect the optimized graph ops (ORT 1.26, same version as the Android build):
#   python - <<'EOF'
#   import onnxruntime as ort, onnx
#   so = ort.SessionOptions()
#   so.optimized_model_filepath = "optimized.onnx"
#   ort.InferenceSession("model.onnx", so, providers=["CPUExecutionProvider"])
#   print(sorted({n.op_type for n in onnx.load("optimized.onnx").graph.node}))
#   EOF
#
# Format: <domain>;<opset>;<op1,op2,...>
ai.onnx;17;Add,ArgMax,Cast,Concat,Constant,Conv,Expand,Gather,Gemm,GRU,MatMul,MaxPool,Mul,Relu,Reshape,Shape,Softmax,Tanh,Transpose,Unsqueeze
